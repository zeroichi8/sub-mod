            </div>
        </div>
    </div>

    <!-- ================= ERROR BANNER (boot failure boundary) ================ -->
    <div id="error-banner" hidden role="alert"
        class="fixed inset-x-0 top-0 z-[210] flex justify-center px-4 pt-3"
        style="padding-top: max(0.75rem, env(safe-area-inset-top));">
        <div class="alert w-auto max-w-sm items-center gap-2 rounded-2xl glass border-0 text-error shadow-2xl shadow-black/30">
            <i class="ph ph-warning-circle shrink-0 text-xl"></i>
            <div class="min-w-0">
                <p class="text-sm font-semibold" data-i18n="error_title">Something went wrong</p>
                <p class="text-[11px] font-normal text-base-content/60" data-i18n="error_desc">The page failed to load fully. Please refresh to try again.</p>
            </div>
        </div>
    </div>

    <main id="app" class="relative mx-auto w-full max-w-3xl px-4 pb-16 pt-5 sm:px-6">

        <!-- ============================ TOP BAR ============================ -->
        <header class="reveal relative z-50 mb-6 flex items-center justify-between gap-3">
            <div class="flex min-w-0 items-center gap-2.5">
                <!-- Logo placeholder: an empty circle (per request). -->
                <div class="h-11 w-11 shrink-0 rounded-full border-2 border-base-content/25"></div>
                <div class="min-w-0 leading-tight">
                    <div class="flex items-center gap-2">
                        <p id="brand-name" class="truncate text-xl font-extrabold tracking-tight gradient-text">SubLink</p>
                        <span id="online-badge" hidden
                            class="badge badge-sm gap-1 border-0 bg-success/15 font-semibold text-success">
                            <span class="online-dot"></span>
                            <span id="online-count">0</span>
                            <span class="hidden sm:inline" data-i18n="online_now">online now</span>
                        </span>
                    </div>
                    <p class="truncate text-[11px] text-base-content/50" data-i18n="tagline">Your connection, beautifully managed</p>
                </div>
            </div>

            <div class="flex shrink-0 items-center gap-2">
                <!-- Language switcher -->
                <button id="lang-toggle" class="btn btn-sm btn-ghost glass gap-1.5 font-semibold"
                    data-i18n-label="switch_lang">
                    <i class="ph ph-globe text-lg opacity-70"></i>
                    <span id="lang-label">EN</span>
                </button>

                <!-- Theme switcher popover -->
                <div id="theme-menu" class="relative">
                    <button id="theme-toggle" class="btn btn-sm btn-ghost glass" aria-haspopup="true"
                        aria-expanded="false" data-i18n-label="switch_theme">
                        <i class="ph ph-palette text-lg"></i>
                    </button>
                    <ul id="theme-list" hidden
                        class="menu glass pop-menu absolute end-0 z-[100] mt-2 w-48 gap-0.5 rounded-2xl p-2 shadow-2xl shadow-black/30">
                    </ul>
                </div>
            </div>
        </header>

        <!-- ===================== STATUS BANNER (edge cases) ===================== -->
        <div id="status-banner" hidden class="reveal alert mb-5 items-center rounded-2xl glass border-0">
            <i class="ph ph-warning-circle shrink-0 text-xl"></i>
            <span id="status-banner-text" class="text-sm font-medium"></span>
        </div>

        <!-- ========================= SERVICE INFO CARD ========================= -->
        <section class="reveal card glass lift mb-6 overflow-hidden rounded-[1.5rem] shadow-2xl shadow-black/20">
            <div class="card-body gap-5 p-5 sm:p-7">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-xs uppercase tracking-widest text-base-content/50" data-i18n="account">Account</p>
                        <h1 id="username" class="truncate text-2xl font-extrabold sm:text-3xl"></h1>
                        <p id="service-name" hidden class="mt-0.5 truncate text-sm text-base-content/60"></p>
                    </div>
                    <span id="status-badge" class="badge badge-lg gap-1.5 border-0 px-3 py-3.5 font-semibold">
                        <span class="h-2 w-2 rounded-full bg-current"></span>
                        <span id="status-badge-text"></span>
                    </span>
                </div>

                <!-- Dual rings: data usage + time remaining -->
                <div class="flex items-center justify-center gap-6 py-1 sm:gap-14">
                    <div id="ring-data" class="ring-wrap">
                        <svg class="ring-svg" viewBox="0 0 100 100" aria-hidden="true">
                            <circle class="ring-track" cx="50" cy="50" r="44" pathLength="100" />
                            <circle id="ring-data-fill" class="ring-fill" cx="50" cy="50" r="44" pathLength="100" />
                        </svg>
                        <div class="ring-label text-center leading-none">
                            <p id="ring-data-pct" class="text-2xl font-extrabold"></p>
                            <p class="mt-0.5 text-[10px] uppercase tracking-wider text-base-content/50" data-i18n="used">Used</p>
                        </div>
                    </div>
                    <div id="ring-time" class="ring-wrap">
                        <svg class="ring-svg" viewBox="0 0 100 100" aria-hidden="true">
                            <circle class="ring-track" cx="50" cy="50" r="44" pathLength="100" />
                            <circle id="ring-time-fill" class="ring-fill" cx="50" cy="50" r="44" pathLength="100" />
                        </svg>
                        <div class="ring-label text-center leading-none">
                            <p id="ring-time-val" class="text-2xl font-extrabold"></p>
                            <p id="ring-time-unit" class="mt-0.5 text-[10px] uppercase tracking-wider text-base-content/50" data-i18n="days">days</p>
                        </div>
                    </div>
                </div>

                <!-- Traffic + expiry stats -->
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                    <div class="rounded-2xl bg-base-100/40 p-3.5">
                        <p class="text-[11px] uppercase tracking-wide text-base-content/50" data-i18n="used">Used</p>
                        <p class="mt-1 text-lg font-bold"><span id="stat-used"></span> <span id="stat-used-unit" class="stat-unit"></span></p>
                    </div>
                    <div class="rounded-2xl bg-base-100/40 p-3.5">
                        <p class="text-[11px] uppercase tracking-wide text-base-content/50" data-i18n="total">Total</p>
                        <p class="mt-1 text-lg font-bold"><span id="stat-total"></span> <span id="stat-total-unit" class="stat-unit"></span></p>
                    </div>
                    <div class="rounded-2xl bg-base-100/40 p-3.5">
                        <p class="text-[11px] uppercase tracking-wide text-base-content/50" data-i18n="remaining">Remaining</p>
                        <p class="mt-1 text-lg font-bold text-accent"><span id="stat-remaining"></span> <span id="stat-remaining-unit" class="stat-unit"></span></p>
                    </div>
                    <div class="rounded-2xl bg-base-100/40 p-3.5">
                        <p class="text-[11px] uppercase tracking-wide text-base-content/50" data-i18n="expires">Expires</p>
                        <p id="stat-expire" class="mt-1 text-lg font-bold"></p>
                    </div>
                </div>

                <!-- Linear usage bar -->
                <div id="usage-bar" hidden class="space-y-1.5">
                    <progress id="usage-progress" class="progress progress-primary h-2.5 w-full" value="0" max="100"></progress>
                    <div class="flex justify-between text-[11px] text-base-content/50">
                        <span id="usage-caption"></span>
                        <span id="usage-pct"></span>
                    </div>
                </div>

                <!-- Quota reset strategy + live countdown -->
                <div id="reset-row" hidden
                    class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-2xl bg-base-100/40 px-3.5 py-2.5">
                    <span class="flex items-center gap-2 text-sm font-medium">
                        <i class="ph ph-arrows-clockwise text-base text-accent"></i>
                        <span data-i18n="reset">Quota reset</span>
                        <span id="reset-label" class="badge badge-sm badge-accent badge-soft"></span>
                    </span>
                    <span class="text-[11px] text-base-content/50">
                        <span data-i18n="resets_in">next in</span>
                        <span id="reset-countdown" class="font-semibold tabular-nums text-base-content/70"></span>
                    </span>
                </div>
            </div>
        </section>

        <!-- ========================= USAGE DASHBOARD ========================= -->
        <section id="usage-card" hidden class="reveal card glass mb-6 overflow-hidden rounded-[1.5rem] border-0 shadow-xl shadow-black/10">
            <button id="usage-head" class="flex w-full items-center justify-between gap-2 p-4 sm:px-5"
                data-collapse="usage-body" aria-expanded="true" aria-controls="usage-body">
                <span class="flex min-w-0 items-center gap-2 text-lg font-bold">
                    <i class="ph ph-chart-bar text-xl text-accent"></i>
                    <span data-i18n="usage_history">Usage history</span>
                    <span id="usage-period" class="truncate text-xs font-normal text-base-content/50"></span>
                </span>
                <i class="ph ph-caret-down chev text-xl text-base-content/50"></i>
            </button>
            <div id="usage-body" class="collapsey open">
                <div class="collapsey-inner">
                    <div class="space-y-3 px-4 pb-4 sm:px-5 sm:pb-5">
                        <div id="usage-chart" class="usage-chart" role="img"></div>
                        <p id="usage-forecast" hidden class="flex items-center gap-2 text-[12px] text-base-content/60">
                            <i class="ph ph-hourglass-medium text-base text-accent"></i>
                            <span id="usage-forecast-text"></span>
                        </p>
                        <div id="usage-alert" hidden class="rounded-xl px-3 py-2 text-[12px] font-semibold"></div>
                        <div id="usage-nodes" hidden class="space-y-2"></div>
                        <p id="usage-updated" hidden class="text-end text-[10px] text-base-content/40"></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============================ CONFIGS ============================ -->
        <section class="reveal card glass mb-6 overflow-hidden rounded-[1.5rem] border-0 shadow-xl shadow-black/10">
            <button class="flex w-full items-center justify-between gap-2 p-4 sm:px-5"
                data-collapse="configs-body" aria-expanded="true" aria-controls="configs-body">
                <span class="flex items-center gap-2 text-lg font-bold">
                    <i class="ph ph-list-bullets text-xl text-primary"></i>
                    <span data-i18n="configs">Configurations</span>
                    <span id="configs-count" class="badge badge-sm badge-primary badge-soft">0</span>
                </span>
                <i class="ph ph-caret-down chev text-xl text-base-content/50"></i>
            </button>

            <div id="configs-body" class="collapsey open">
                <div class="collapsey-inner">
                    <div class="px-4 pb-4 sm:px-5 sm:pb-5">
                        <!-- Bulk actions -->
                        <div class="mb-3 flex flex-wrap gap-2">
                            <button id="copy-sub" class="btn glass lift min-w-[8rem] flex-1 gap-2 rounded-2xl border-0 font-semibold">
                                <i class="ph ph-link-simple text-lg"></i>
                                <span data-i18n-dyn="copy_sub">Copy sub link</span>
                            </button>
                            <button id="copy-all" class="btn glass lift min-w-[8rem] flex-1 gap-2 rounded-2xl border-0 font-semibold">
                                <i class="ph ph-copy text-lg"></i>
                                <span data-i18n-dyn="copy_all">Copy all</span>
                            </button>
                            <button id="sub-qr" class="btn btn-square glass lift rounded-2xl border-0" data-i18n-label="sub_qr">
                                <i class="ph ph-qr-code text-xl text-primary"></i>
                            </button>
                        </div>

                        <!-- Search + tools -->
                        <div id="configs-toolbar" class="mb-3 flex flex-wrap items-center gap-2">
                            <label class="cfg-search glass flex min-w-[10rem] flex-1 items-center gap-2 rounded-2xl px-3">
                                <i class="ph ph-magnifying-glass text-base text-base-content/40"></i>
                                <input id="config-search" type="search" autocomplete="off" spellcheck="false"
                                    class="h-9 w-full min-w-0 bg-transparent text-sm outline-none placeholder:text-base-content/35"
                                    data-i18n-ph="search_configs" data-i18n-label="search_configs" />
                            </label>
                            <button id="config-group" class="btn btn-sm btn-ghost glass btn-square rounded-xl"
                                aria-pressed="false" data-i18n-label="group_by_country" data-i18n-title="group_by_country">
                                <i class="ph ph-flag text-lg"></i>
                            </button>
                            <button id="config-select" class="btn btn-sm btn-ghost glass btn-square rounded-xl"
                                aria-pressed="false" data-i18n-label="select_configs" data-i18n-title="select_configs">
                                <i class="ph ph-checks text-lg"></i>
                            </button>
                            <button id="config-export" class="btn btn-sm btn-ghost glass btn-square rounded-xl"
                                data-i18n-label="export_configs" data-i18n-title="export_configs">
                                <i class="ph ph-download-simple text-lg"></i>
                            </button>
                        </div>

                        <!-- Protocol filter pills (built at runtime) -->
                        <div id="config-filters" hidden class="no-scrollbar mb-3 flex gap-1.5 overflow-x-auto"
                            role="tablist" aria-label="Filter by protocol"></div>

                        <!-- Bulk-selection bar -->
                        <div id="selection-bar" hidden class="mb-3 flex items-center justify-between gap-2 rounded-2xl bg-primary/10 px-3.5 py-2">
                            <span class="text-sm font-medium">
