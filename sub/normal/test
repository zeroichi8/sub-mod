                                <span data-i18n-dyn="selected">selected</span>
                            </span>
                            <button id="copy-selected" class="btn btn-sm btn-primary gap-1.5 rounded-xl font-semibold">
                                <i class="ph ph-copy text-base"></i>
                                <span data-i18n-dyn="copy_selected">Copy selected</span>
                            </button>
                        </div>

                        <!-- Config list -->
                        <div id="configs-list" class="space-y-2.5"></div>
                    </div>
                </div>
            </div>
