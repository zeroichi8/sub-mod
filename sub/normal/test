        <dialog id="qr-modal" class="modal modal-bottom sm:modal-middle">
            <div class="modal-box glass max-w-sm rounded-[1.5rem] border-0 text-center">
                <h3 id="qr-title" class="mb-1 text-lg font-bold"></h3>
                <p id="qr-text" dir="ltr" class="mb-4 truncate font-mono text-[11px] text-base-content/40"></p>
                <div class="mx-auto grid aspect-square w-full max-w-[260px] place-items-center rounded-2xl bg-white p-4">
                    <div id="qr-box" class="qr-box h-full w-full"></div>
                </div>
                <div class="modal-action mt-5 justify-center gap-2">
                    <button id="qr-copy" class="btn btn-primary flex-1 rounded-2xl font-semibold">
                        <span data-i18n-dyn="copy">Copy</span>
                    </button>
                    <button id="qr-close" class="btn btn-ghost glass flex-1 rounded-2xl" data-i18n="close">Close</button>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop"><button>close</button></form>
        </dialog>

        <!-- ============================== TOAST ============================== -->
        <div id="toast" hidden role="status" aria-live="polite"
            class="toast-pill glass fixed bottom-5 left-1/2 z-[300] rounded-2xl px-4 py-2.5 text-sm font-semibold shadow-2xl shadow-black/30"></div>
