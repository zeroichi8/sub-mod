<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="auroradark">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#141c28" />
    <title>SubLink</title>

    <!--
      Default brand name. The panel's "Subscription profile title" setting
      (subscription_profile_title binding, data island below) wins when
      present, then the legacy brand_name binding; when both are empty this
      meta is the fallback shown in the splash, header, title and PWA
      manifest. To rebrand an already-built dist/index.html without
      rebuilding:  sed -i 's/\bAurora\b/YourBrand/g' index.html
    -->
    <meta name="aurora-brand" content="Aurora" />

    <!--
      Blocking pref resolver: apply the saved/queried theme and language BEFORE
      first paint so there is no flash of the default theme or LTR layout.
      Plain JS only; the build guard forbids template directives here.
    -->
    <script>
        (function () {
            try {
                var doc = document.documentElement;
                var q = new URLSearchParams(location.search);
                var themes = ["auroradark", "amoleddark", "auroralight", "nord"];
                var t = q.get("theme");
                if (themes.indexOf(t) < 0) {
                    t = null;
                    try { t = localStorage.getItem("aurora_theme"); } catch (e) { t = null; }
                }
                if (themes.indexOf(t) < 0 && window.matchMedia) {
                    if (matchMedia("(prefers-color-scheme: light)").matches) t = "auroralight";
                }
                if (themes.indexOf(t) >= 0) doc.setAttribute("data-theme", t);
                var l = q.get("lang");
                if (l !== "en" && l !== "fa") {
                    l = null;
                    try { l = localStorage.getItem("aurora_lang"); } catch (e) { l = null; }
                }
                if (l !== "en" && l !== "fa") {
                    l = (navigator.language || "").toLowerCase().indexOf("fa") === 0 ? "fa" : "en";
                }
                doc.lang = l;
                doc.dir = l === "fa" ? "rtl" : "ltr";
            } catch (e) { /* keep markup defaults */ }
        })();
    </script>

